@model ChatAndEvents.Web.Models.CommunityIndexViewModel

@{
    ViewData["Title"] = "Communities";
}

<div class="hub-page wp-board-page">
    <div class="page-title-row">
        <div>
            <h1>Communities</h1>
            <p class="text-muted mb-0">Search categories, join groups, and follow the conversations that fit you.</p>
        </div>
    </div>

    @if (TempData["CommunityMessage"] != null)
    {
        <div class="alert alert-info">@TempData["CommunityMessage"]</div>
    }

    <form method="get" class="filter-bar">
        <input name="query" value="@Model.Query" class="form-control" placeholder="Search communities" />
        <select name="category" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category" selected="@(category == Model.Category)">@category</option>
            }
        </select>
        <button class="btn btn-primary" type="submit">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>

    <div class="hub-grid">
        <section class="hub-panel wp-start-panel" id="start-community">
            <h2>Start a Community</h2>
            <div class="wp-banner-placeholder">
                <span>Choose banner</span>
            </div>
            <form asp-action="Create" method="post" class="stack-form">
                @Html.AntiForgeryToken()
                <input name="name" class="form-control wp-title-input" placeholder="Pick a name..." maxlength="120" required />
                <input name="category" class="form-control" placeholder="Category" maxlength="80" />
                <textarea name="description" class="form-control" rows="4" placeholder="Description" maxlength="1000" required></textarea>
                <button type="submit" class="btn wp-primary-button">Create the community</button>
            </form>
        </section>

        <section class="hub-panel">
            <h2>Discover</h2>
            <div class="community-list">
                @if (!Model.Communities.Any())
                {
                    <p class="text-muted mb-0">No communities found.</p>
                }
                else
                {
                    @foreach (var item in Model.Communities)
                    {
                        <a class="community-list-item wp-post-card wp-community-post" asp-action="Details" asp-route-id="@item.Community.Id">
                            <div class="wp-community-rail">
                                @if (!string.IsNullOrWhiteSpace(item.Community.BannerUrl))
                                {
                                    <img class="wp-community-thumb" src="@item.Community.BannerUrl" alt="@item.Community.Name banner" />
                                }
                                <div class="wp-vote-stack">
                                    <span>&#9650;</span>
                                    <strong>@item.MemberCount</strong>
                                    <span>&#9660;</span>
                                </div>
                            </div>
                            <div class="wp-post-body">
                                <div class="wp-post-meta">
                                    <strong>@item.Community.Category</strong>
                                    <span>@(item.IsCurrentUserMember ? "Joined" : "Discovery")</span>
                                </div>
                                <h3>@item.Community.Name</h3>
                                <p>@item.Community.Description</p>
                            </div>
                        </a>
                    }
                }
            </div>
        </section>
    </div>
</div>
